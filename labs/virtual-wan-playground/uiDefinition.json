{
	"$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
	"view": {
		"kind": "Form",
		"properties": {
			"title": "Hub & Spoke playground - LAB Builder",
			"steps": [
				{
					"name": "basics",
					"label": "Basics",
					"elements": [
						{
							"name": "Intro",
							"type": "Microsoft.Common.Section",
							"label": "Azure Hub & Spoke Playground - Basics",
							"elements": [
								{
									"name": "IntroText",
									"type": "Microsoft.Common.TextBlock",
									"options": {
										"text": "The Hub & Spoke Lab Builder playground allows you to deploy a Hub & Spoke or Virtual WAN (vWAN) network topology in Azure, supporting both single and multi-region setups. You can selectively deploy components such as Hubs, Spokes, and simulated On-Premises environments. Within each section, you can choose to include resources like VNETs, vWAN, Bastion, VPN Gateway,Virtual Machines and Azure Firewall.",
										"link": {
											"label": "Learn more",
											"uri": "https://github.com/jonathan-vella/azure-networking/tree/main/labs/virtual-wan-playground"
										}
									}
								},
								{
									"name": "infoBox",
									"type": "Microsoft.Common.InfoBox",
									"options": {
										"style": "Info",
										"text": "Select below a Subscription and Region for the deployment. The selected subscription and region will be used for the inital deployment. You can select Subscriptions and Regions for resources on specific tabs for Hub, Spoke and OnPrem."
									},
									"visible": true
								}
							]
						},
						{
							"name": "resourceScope",
							"type": "Microsoft.Common.ResourceScope"
						}
					]
				},
				{
					"name": "Regions",
					"label": "Region(s)",
					"elements": [
						{
							"name": "Intro",
							"type": "Microsoft.Common.Section",
							"label": "Azure Hub & Spoke Playground - Regions(s)",
							"elements": [
								{
									"name": "IntroText",
									"type": "Microsoft.Common.TextBlock",
									"options": {
										"text": "Specify if you want to deploy in single or multi region. If you choose to deploy in multiple regions, the regions cannot be the same. The address spaces for the VNET's in the different regions also cannot be the same. The address space must be a /16 subnet (per region).",
										"link": {
											"label": "Learn more",
											"uri": "https://github.com/jonathan-vella/azure-networking/tree/main/labs/virtual-wan-playground"
										}
									}
								}
							]
						},
						{
							"name": "First",
							"type": "Microsoft.Common.Section",
							"label": "First Region",
							"elements": [
								{
									"name": "Region",
									"type": "Microsoft.Common.LocationSelector",
									"label": "Azure Region:",
									"scope": {
										"subscriptionId": "[steps('basics').resourceScope.subscription.subscriptionId]"
									},
									"toolTip": "Select a region for deployment, excluding the previously selected region."
								},
								{
									"name": "AddressSpace",
									"type": "Microsoft.Common.TextBox",
									"label": "IP Address Space",
									"defaultValue": "172.16.0.0/16",
									"toolTip": "IP Address space used for VNETs in deployment. Only enter a /16 subnet. Default = 172.16.0.0/16",
									"constraints": {
										"required": true,
										"regex": "^(10(?:\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))\\.0\\.0\\/16)|(172\\.(?:1[6-9]|2\\d|3[0-1])\\.0\\.0\\/16)|(192\\.168\\.0\\.0\\/16)",
										"validationMessage": "The value must match a /16 subnet. 10.[0-255].0.0/16 or 172.[16-31].0.0/16 or 192.168.0.0/16"
									},
									"visible": true
								}
							]
						},
						{
							"name": "DeployMultiRegion",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy in Multi Region?",
							"defaultValue": "no",
							"toolTip": "When Multi Region is selected, deploy global VNET Peering between Hub VNET's. only applicable for VNET deployments",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								]
							},
							"visible": true
						},
						{
							"name": "Second",
							"type": "Microsoft.Common.Section",
							"label": "Second Region",
							"elements": [
								{
									"name": "Region",
									"type": "Microsoft.Common.LocationSelector",
									"label": "Azure Region:",
									"scope": {
										"subscriptionId": "[steps('basics').resourceScope.subscription.subscriptionId]"
									},
									"toolTip": "Select the second region for deployment. Default = First Region"
								},
								{
									"name": "AddressSpace",
									"type": "Microsoft.Common.TextBox",
									"label": "IP Address Space",
									"defaultValue": "172.31.0.0/16",
									"toolTip": "IP Address space used for VNETs in deployment. Only enter a /16 subnet. Default = 172.16.0.0/16",
									"constraints": {
										"required": true,
										"regex": "^(10(?:\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))\\.0\\.0\\/16)|(172\\.(?:1[6-9]|2\\d|3[0-1])\\.0\\.0\\/16)|(192\\.168\\.0\\.0\\/16)",
										"validationMessage": "The value must match a /16 subnet. 10.[0-255].0.0/16 or 172.[16-31].0.0/16 or 192.168.0.0/16"
									},
									"visible": true
								},
								{
									"name": "infoBox1",
									"type": "Microsoft.Common.InfoBox",
									"options": {
										"style": "Error",
										"text": "When deploying in multiple regions, the Regions cannot be the same. please select different regions"
									},
									"visible": "[equals(steps('Regions').First.Region.displayName,steps('Regions').Second.Region.displayName)]"
								},
								{
									"name": "infoBox2",
									"type": "Microsoft.Common.InfoBox",
									"options": {
										"style": "Error",
										"text": "When deploying in multiple regions, the Address Spaces cannot be the same. please select different Address Spaces"
									},
									"visible": "[equals(steps('Regions').First.AddressSpace,steps('Regions').Second.AddressSpace)]"
								}
							],
							"visible": "[equals(steps('Regions').DeployMultiRegion,true)]"
						}
					]
				},
				{
					"name": "Hub",
					"label": "Hub(s)",
					"elements": [
						{
							"name": "Intro",
							"type": "Microsoft.Common.Section",
							"label": "Azure Hub & Spoke Playground - Hub",
							"elements": [
								{
									"name": "IntroText",
									"type": "Microsoft.Common.TextBlock",
									"options": {
										"text": "Choose to deploy a Hub. The Hub can be deployed as a VNET or as a VWAN. The Hub can also be used to deploy a Firewall, Bastion and/or VPN Gateway. The Hub will be connected to the Spoke VNET's.",
										"link": {
											"label": "Learn more",
											"uri": "https://github.com/jonathan-vella/azure-networking/tree/main/labs/virtual-wan-playground"
										}
									}
								}
							]
						},
						{
							"name": "Deploy",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy Hub(s)",
							"defaultValue": "yes",
							"toolTip": "Deploy Hub VNET",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": true
						},
						{
							"name": "First",
							"type": "Microsoft.Common.Section",
							"label": "First Region Hub Subscription",
							"elements": [
								{
									"name": "InfoText",
									"type": "Microsoft.Common.TextBlock",
									"visible": true,
									"options": {
										"text": "[concat('Select subscription for region: <b>',steps('Regions').First.Region.displayName,'</b>')]"
									}
								},
								{
									"type": "Microsoft.Common.SubscriptionSelector",
									"name": "Subscription"
								}
							],
							"visible": "[equals(steps('Hub').Deploy,true)]"
						},
						{
							"name": "Second",
							"type": "Microsoft.Common.Section",
							"label": "Second Region Hub Subscription",
							"elements": [
								{
									"name": "InfoText",
									"type": "Microsoft.Common.TextBlock",
									"visible": true,
									"options": {
										"text": "[concat('Select subscription for region: <b>',steps('Regions').Second.Region.displayName,'</b>')]"
									}
								},
								{
									"type": "Microsoft.Common.SubscriptionSelector",
									"name": "Subscription"
								}
							],
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Regions').DeployMultiRegion,true))]"
						},
						{
							"name": "VNETorVWAN",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Hub as vWAN or VNET",
							"defaultValue": "VNET",
							"toolTip": "Deploy Hub as Virtual or in traditional VNET?",
							"constraints": {
								"allowedValues": [
									{
										"label": "VNET",
										"value": "VNET"
									},
									{
										"label": "VWAN",
										"value": "VWAN"
									}
								],
								"required": true
							},
							"visible": "[equals(steps('Hub').Deploy,true)]"
						},
						{
							"name": "deployVnetPeeringAVNM",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy Azure Virtual Network Manager (AVNM)",
							"defaultValue": "no",
							"toolTip": "Let Azure Virtual Network Manager manage VNET Peerings",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').VNETorVWAN,'VNET'))]"
						},
						{
							"name": "hubRgName",
							"type": "Microsoft.Common.TextBox",
							"label": "Hub Resource Group prefix Name",
							"defaultValue": "rg-hub",
							"toolTip": "Use only allowed characters. A prefix will be added to the resource group name. Example: rg-hub-<region>",
							"placeholder": "",
							"multiLine": false,
							"constraints": {
								"required": true,
								"validations": [
									{
										"regex": "^[a-zA-Z0-9_\\-\\.]+$",
										"message": "Only alphanumeric and numeric characters are allowed including symbols like: _ and . and -"
									}
								]
							},
							"visible": "[equals(steps('Hub').Deploy,true)]"
						},
						{
							"name": "deployBastionInHub",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy Bastion In Hub",
							"defaultValue": "no",
							"toolTip": "Deploy Bastion Host in Hub VNET",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').VNETorVWAN,'VNET'))]"
						},
						{
							"name": "bastionInHubSKU",
							"type": "Microsoft.Common.DropDown",
							"label": "Azure Bastion SKU",
							"defaultValue": "Standard",
							"toolTip": "Azure Bastion SKU: Basic, Standard, or Premium",
							"constraints": {
								"required": false,
								"allowedValues": [
									{
										"label": "Standard",
										"value": "Standard"
									},
									{
										"label": "Basic",
										"value": "Basic"
									},
									{
										"label": "Premium",
										"value": "Premium"
									}
								]
							},
							"visible": "[equals(steps('Hub').deployBastionInHub,true)]"
						},
						{
							"name": "deployGatewayInHub",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy Virtual Network Gateway In Hub",
							"defaultValue": "no",
							"toolTip": "Deploy Virtual Network Gateway in Hub VNET",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": "[equals(steps('Hub').Deploy,true)]"
						},
						{
							"name": "hubBgp",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Enable BGP",
							"defaultValue": "no",
							"toolTip": "Enable BGP on VPN Gateway",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').deployGatewayInHub,true))]"
						},
						{
							"name": "hubBgpAsn",
							"type": "Microsoft.Common.TextBox",
							"label": "Hub BGP ASN",
							"defaultValue": "",
							"toolTip": "Use only allowed characters. For VNET deployments: default BGP ASN for Hub = 65010. For vWAN deployments: default BGP for vWAN Hub = 65515",
							"placeholder": "[if(equals(steps('Hub').VNETorVWAN,'VNET'),65010,65515)]",
							"multiLine": false,
							"constraints": {
								"required": true,
								"validations": [
									{
										"regex": "\\b\\d{5}\\b",
										"message": "Only 5 digit number"
									},
									{
										"isValid": "[or(and(equals(steps('Hub').hubBgpAsn,'65515'),equals(steps('Hub').VNETorVWAN,'VWAN')),and(not(equals(steps('Hub').hubBgpAsn,'65515')),equals(steps('Hub').VNETorVWAN,'VNET')))]",
										"message": "Use only allowed characters. For VNET deployments: default BGP ASN for Hub = 65010. For vWAN deployments: default BGP for vWAN Hub = 65515. Note1: Hub BGP and OnPrem BGP cannot be the same. Note2: BGP on Site-to-Site VPN tunnels between Azure VPN gateways (VNET only) cannot use the Azure default BGP ASN 65515, therefore defaulting to BGP ASN 65010."
									}
								]
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').deployGatewayInHub,true),equals(steps('Hub').hubBgp,true))]"
						},
						{
							"name": "deployFirewallInHub",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy Firewall In Hub",
							"defaultValue": "no",
							"toolTip": "Deploy Azure Firewall in Hub VNET. includes deployment of custom route tables in Spokes and Hub VNETs",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": "[equals(steps('Hub').Deploy,true)]"
						},
						{
							"name": "AzureFirewallTier",
							"type": "Microsoft.Common.DropDown",
							"label": "Azure Firewall Tier",
							"defaultValue": "Standard",
							"toolTip": "Azure Firewall Tier: Standard or Premium",
							"constraints": {
								"required": false,
								"allowedValues": [
									{
										"label": "Standard",
										"value": "Standard"
									},
									{
										"label": "Premium",
										"value": "Premium"
									}
								]
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').deployFirewallInHub,true))]"
						},
						{
							"name": "AzureFirewallDNSproxy",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Enable Azure Firewall DNS Proxy",
							"defaultValue": "no",
							"toolTip": "Enable Azure Firewall DNS Proxy",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').deployFirewallInHub,true))]"
						},
						{
							"name": "deployFirewallrules",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy Firewall policy rules",
							"defaultValue": "yes",
							"toolTip": "Deploy Firewall policy Rule Collection group which allows spoke-to-spoke and internet traffic",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').deployFirewallInHub,true))]"
						},
						{
							"name": "deployUDRs",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy route tables (UDR's) to VM subnet(s) in Hub and Spokes",
							"defaultValue": "yes",
							"toolTip": "Deploy route tables (UDR's) to VM subnet(s) in Hub and Spokes",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').VNETorVWAN,'VNET'),equals(steps('Hub').deployFirewallInHub,true))]"
						},
						{
							"name": "enableRoutingIntent",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Enable Azure vWAN Routing Intent",
							"defaultValue": "no",
							"toolTip": "Enable Azure vWAN Routing Intent for Internet and/or Public IP traffic to be routed through Azure Firewall in vWAN Hub. Requires Azure Firewall to be deployed in vWAN Hub",
							"constraints": {
								"allowedValues": [
									{
										"label": "no",
										"value": false
									},
									{
										"label": "Private Traffic Only",
										"value": "private"
									},
									{
										"label": "Internet Traffic Only",
										"value": "internet"
									},
									{
										"label": "Internet and Private Traffic",
										"value": "privateAndInternet"
									}
								],
								"required": true
							},
							"visible": "[and(equals(steps('Hub').Deploy,true),equals(steps('Hub').VNETorVWAN,'VWAN'),equals(steps('Hub').deployFirewallInHub,true))]"
						}
					]
				},
				{
					"name": "Spoke",
					"label": "Spoke(s)",
					"elements": [
						{
							"name": "Intro",
							"type": "Microsoft.Common.Section",
							"label": "Azure Hub & Spoke Playground - Spoke VNET's",
							"elements": [
								{
									"name": "IntroText",
									"type": "Microsoft.Common.TextBlock",
									"options": {
										"text": "Choose to deploy Spoke(s). If a Hub is deployed, the Spokes will be connected to the Hub (Eithter VNET or VWAN).",
										"link": {
											"label": "Learn more",
											"uri": "https://github.com/jonathan-vella/azure-networking/tree/main/labs/virtual-wan-playground"
										}
									}
								}
							]
						},
						{
							"name": "Deploy",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Deploy Spokes",
							"defaultValue": "yes",
							"toolTip": "Deploy Spoke VNETs",
							"constraints": {
								"allowedValues": [
									{
										"label": "yes",
										"value": true
									},
									{
										"label": "no",
										"value": false
									}
								],
								"required": true
							},
							"visible": true
						},
						{
							"name": "First",
							"type": "Microsoft.Common.Section",
							"label": "First Region Spoke Subscription",
							"elements": [
								{
									"name": "InfoText",
									"type": "Microsoft.Common.TextBlock",
									"visible": true,
									"options": {
										"text": "[concat('Select subscription for region: <b>',steps('Regions').First.Region.displayName,'</b>')]"
									}
								},
								{
									"type": "Microsoft.Common.SubscriptionSelector",
									"name": "Subscription"
								}
							],
							"visible": "[equals(steps('Spoke').Deploy,true)]"
						},
						{
							"name": "Second",
							"type": "Microsoft.Common.Section",
							"label": "Second Region Spoke Subscription",
							"elements": [
								{
									"name": "InfoText",
									"type": "Microsoft.Common.TextBlock",
									"visible": true,
									"options": {
										"text": "[concat('Select subscription for region: <b>',steps('Regions').Second.Region.displayName,'</b>')]"
									}
								},
								{
									"type": "Microsoft.Common.SubscriptionSelector",
									"name": "Subscription"
								}
							],
							"visible": "[and(equals(steps('Spoke').Deploy,true),equals(steps('Regions').DeployMultiRegion,true))]"
						},
						{
							"name": "spokeRgNamePrefix",
							"type": "Microsoft.Common.TextBox",
							"label": "Spoke Resource Group prefix Name",
							"defaultValue": "rg-spoke",
							"toolTip": "Use only allowed characters. A prefix will be added to the resource group name. Example: rg-hub-<region>",
							"placeholder": "",
							"multiLine": false,
							"constraints": {
								"required": true,
								"validations": [
									{
										"regex": "^[a-zA-Z0-9_\\-\\.]+$",
										"message": "Only alphanumeric and numeric characters are allowed including symbols like: _ and . and -"
									}
								]
							},
							"visible": "[equals(steps('Spoke').Deploy,true)]"
						},
						{
							"name": "amountOfSpokes",
							"type": "Microsoft.Common.Slider",
							"min": 1,
							"max": 25,
							"label": "Amount Of Spokes",
							"subLabel": "# of Spokes",
							"defaultValue": 2,
							"showStepMarkers": false,
							"toolTip": "Amount of Spoke VNETs you want to deploy. Default = 2",
							"constraints": {
								"required": false
							},
							"visible": "[equals(steps('Spoke').Deploy,true)]"
						},
						{
							"name": "deployVnetPeeringMesh",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Directly connect Spoke VNET's in AVNM topology",
							"defaultValue": "no",
