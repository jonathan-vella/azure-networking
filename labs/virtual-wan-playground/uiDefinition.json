				"deployGatewayInHub": "[or(coalesce(steps('Hub').deployGatewayInHub,false),coalesce(steps('OnPrem').deploySite2Site,false))]",
				"hubBgp": "[coalesce(steps('Hub').hubBgp,false)]",
				"hubBgpAsn": "[int(if(empty(coalesce(steps('Hub').hubBgpAsn,'')),if(equals(coalesce(steps('Hub').VNETorVWAN,'VNET'),'VNET'),'65010','65515'),steps('Hub').hubBgpAsn))]",
				"deployFirewallInHub": "[coalesce(steps('Hub').deployFirewallInHub,false)]",
				"AzureFirewallTier": "[coalesce(steps('Hub').AzureFirewallTier,'Standard')]",
				"deployUDRs": "[coalesce(steps('Hub').deployUDRs,true)]",
				"spokeRgNamePrefix": "[coalesce(steps('Spoke').spokeRgNamePrefix,'rg-spoke')]",
				"deployFirewallrules": "[coalesce(steps('Hub').deployFirewallrules,false)]",
				"firewallDNSproxy": "[coalesce(steps('Hub').AzureFirewallDNSproxy,false)]",
				"deployOnPrem": "[coalesce(steps('OnPrem').Deploy,false)]",
				"onpremRgName": "[coalesce(steps('OnPrem').OnPremRgName,'rg-onprem')]",
				"deployBastionInOnPrem": "[coalesce(steps('OnPrem').deployBastionInOnPrem,false)]",
				"deployGatewayinOnPrem": "[coalesce(steps('OnPrem').deployGatewayInOnPrem,false)]",
				"onpremBgp": "[coalesce(steps('OnPrem').onpremBgp,false)]",
				"onpremBgpAsn": "[int(if(empty(coalesce(steps('OnPrem').onpremBgpAsn,'')),'65020',steps('OnPrem').onpremBgpAsn))]",
				"deploySiteToSite": "[and(equals(steps('OnPrem').deploySite2Site,true),equals(steps('OnPrem').deployGatewayInOnPrem,true),equals(steps('Hub').deployGatewayInHub,true))]",
				"sharedKey": "[coalesce(steps('OnPrem').sharedKey,'')]",
				"bastionInHubSKU": "[coalesce(steps('Hub').bastionInHubSKU,'Standard')]",
				"bastionInOnPremSKU": "[coalesce(steps('OnPrem').bastionInOnPremSKU,'Standard')]",
				"vmSizeSpoke": "[coalesce(steps('VirtualMachines').SpokevmSizeSection.vmSize,'Standard_B2ls_v2')]",
				"vmSizeOnPrem": "[coalesce(steps('VirtualMachines').OnPremvmSizeSection.vmSize,'Standard_B2ls_v2')]",
				"osTypeSpoke": "[coalesce(steps('VirtualMachines').SpokevmSizeSection.osType,'Windows')]",
				"osTypeOnPrem": "[coalesce(steps('VirtualMachines').OnPremvmSizeSection.osType,'Windows')]",
				"diagnosticWorkspaceId": "[coalesce(steps('VirtualMachines').lawSelectorForAMA.id,'')]",
				"internetTrafficRoutingPolicy": "[or(equals(steps('Hub').enableRoutingIntent,'internet'),equals(steps('Hub').enableRoutingIntent,'privateAndInternet'))]",
				"privateTrafficRoutingPolicy": "[or(equals(steps('Hub').enableRoutingIntent,'private'),equals(steps('Hub').enableRoutingIntent,'privateAndInternet'))]"
			},
			"kind": "Subscription",
			"subscriptionId": "[steps('basics').resourceScope.subscription.id]",
			"location": "[steps('basics').resourceScope.location.name]"
		}
	}
