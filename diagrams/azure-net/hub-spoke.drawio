        <UserObject label="&lt;span style=&quot;font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;ASN:65515&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" tags="" id="171">
          <mxCell style="text;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Architects Daughter;fontColor=#000000;sketch=1;curveFitting=1;jiggle=2;labelBackgroundColor=#FFFF66;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="LdFzTjZZUpQZ4FR4s8Bu-2" vertex="1">
            <mxGeometry x="-2382" y="-309" width="108" height="26" as="geometry" />
