-size: 38px;&quot;&gt;Second Circuit (same region, lower bandwidth)&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 38px;&quot;&gt;&lt;font style=&quot;font-size: 38px;&quot;&gt;&lt;ol style=&quot;font-size: 38px;&quot;&gt;&lt;li style=&quot;font-size: 38px;&quot;&gt;&lt;b style=&quot;font-size: 38px;&quot;&gt;ECMP Blue and Pink Path&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 38px;&quot;&gt;&lt;b style=&quot;font-size: 38px;&quot;&gt;Lower Bandwidth - AS-Prepend SEcond circuit&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 38px;&quot;&gt;&lt;b style=&quot;font-size: 38px;&quot;&gt;Example&lt;/b&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div style=&quot;font-size: 38px;&quot;&gt;&lt;b style=&quot;background-color: rgb(255, 255, 51); font-size: 38px;&quot;&gt;Second Circuit (different region)&lt;/b&gt;&lt;/div&gt;&lt;ol style=&quot;font-size: 38px;&quot;&gt;&lt;li style=&quot;font-size: 38px;&quot;&gt;&lt;b style=&quot;font-size: 38px;&quot;&gt;ECMP Blue and Pink Path, Latency - Blue Path&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 38px;&quot;&gt;&lt;b style=&quot;background-color: initial; font-size: 38px;&quot;&gt;Pink Path Preferred&lt;/b&gt;&lt;/li&gt;&lt;/ol&gt;&lt;span style=&quot;background-color: rgb(255, 255, 51); font-size: 38px;&quot;&gt;&lt;b style=&quot;font-size: 38px;&quot;&gt;Add 2nd Region:&lt;/b&gt;&lt;br style=&quot;font-size: 38px;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;div style=&quot;font-size: 38px;&quot;&gt;&lt;b style=&quot;font-size: 38px;&quot;&gt;&lt;font style=&quot;font-size: 38px;&quot;&gt;Mulit-region&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 38px;&quot;&gt;&lt;b style=&quot;font-size: 38px;&quot;&gt;&lt;font style=&quot;font-size: 38px;&quot;&gt;AVS in Other region&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 38px;&quot;&gt;&lt;font style=&quot;font-size: 38px;&quot;&gt;&lt;br style=&quot;font-size: 38px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;fon