        </UserObject>
        <mxCell id="197" value="&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Architects+Daughter&quot; style=&quot;font-size: 45px;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 50px;&quot;&gt;&lt;font style=&quot;font-size: 50px;&quot;&gt;NVA-EW Layer (All East-West flows via NVA, execpt the &lt;font style=&quot;font-size: 50px;&quot; color=&quot;#cc6600&quot;&gt;orange flows&lt;/font&gt;)&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Architects+Daughter&quot; style=&quot;font-size: 45px;&quot;&gt;&lt;b&gt;&lt;ol style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 45px;&quot;&gt;Leverage Gateway Subnet Route table to preserve symettry&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;font style=&quot;font-size: 45px;&quot;&gt;Gateway Subnet Route table&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;Name&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Address prefix&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Next hop type&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Next hop IP address&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 45px;&quot; color=&quot;#ff0000&quot;&gt;Route-to-avs-segement&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;10.100.220.0/24&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Virtual appliance&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;172.16.25.4&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;route-to-branch1&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;10.10.2.0/24&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Virtual appliance&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;172.16.25.4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;route-to-branch2&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;10.8.1.0/24&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Virtual appliance&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;172.16.25.4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;route-to-HQ&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;10.99.0.0/16&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Virtual appliance&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;172.16.25.4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;route-to-p2s-pool-1&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;192.168.98.0/25&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Virtual appliance&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;172.16.25.4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;route-to-p2s-pool-2&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;192.168.98.128/25&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Virtual appliance&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;172.16.25.4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 0);&quot;&gt;route-to-spoke1&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;10.1.0.0/16&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Virtual appliance&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;172.16.25.4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;route-to-spoke2&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;10.2.0.0/16&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;Virtual appliance&lt;span style=&quot;&quot;&gt;&#x9;&lt;/span&gt;172.16.25.4&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;4. ER VPN Transit via NVA using ARS.&amp;nbsp; ARS not in the data path.&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;On-Prem &lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;S2S firewall (ASAv) Learns ExR Routes.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;GatewaySubnet Route table steers it&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;to the NVA.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;asav01(config)# sho route bgp&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;Codes: L - local, C - connected, S - static, R - RIP, M - mobile, B - BGP&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;D - EIGRP, EX - EIGRP external, O - OSPF, IA - OSPF inter area&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;N1 - OSPF NSSA external type 1, N2 - OSPF NSSA external type 2&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;E1 - OSPF external type 1, E2 - OSPF external type 2, V - VPN&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;i - IS-IS, su - IS-IS summary, L1 - IS-IS level-1, L2 - IS-IS level-2&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;ia - IS-IS inter area, * - candidate default, U - per-user static route&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;o - ODR, P - periodic downloaded static route, + - replicated route&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;SI - Static InterVRF, BI - BGP InterVRF&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;Gateway of last resort is 10.10.3.1 to network 0.0.0.0&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;B&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 0.0.0.0 128.0.0.0 [20/0] via 172.16.0.15, 00:11:55&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;B&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 10.0.0.0 255.0.0.0 [20/0] via 172.16.0.15, 00:11:55&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;B&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 10.8.1.0 255.255.255.0 [20/0] via 172.16.0.15, 01:41:02&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 0);&quot;&gt;B&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 10.99.0.0 255.255.0.0 [20/0] via 172.16.0.15, 00:00:09&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;B&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 11.11.11.0 255.255.255.0 [20/0] via 172.16.0.15, 00:11:55&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;B&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 128.0.0.0 128.0.0.0 [20/0] via 172.16.0.15, 00:11:55&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;B&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 192.168.98.0 255.255.255.128 [20/0] via 172.16.0.15, 01:41:02&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;B&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 192.168.98.128 255.255.255.128 [20/0] via 172.16.0.15, 01:41:02&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 45px;&quot; color=&quot;#ff0000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 45px;&quot; color=&quot;#ff0000&quot;&gt;5. ER to ER Transit Via NVA&amp;nbsp;&lt;/font&gt; (&lt;a href=&quot;https://learn.microsoft.com/en-us/azure/azure-vmware/concepts-network-design-considerations#supernet-design-topology&quot;&gt;Supernet design topology&lt;/a&gt; -&lt;font style=&quot;font-size: 45px;&quot; color=&quot;#ff0000&quot;&gt; link to Azure Documentation for caveats)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Adveritize 10/8 (Supernet) via NVA to attract the traffic to the ExR GW and then use the GW subnet&lt;/div&gt;&lt;div style=&quot;&quot;&gt;route table. This design has lot of operational overhead, UDR limit considerations and NVA attracting traffic&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;that it shouldn&#39;t). Alternate design with &lt;a href=&quot;https://learn.microsoft.com/en-us/azure/azure-vmware/concepts-network-design-considerations#transit-spoke-virtual-network-topology&quot;&gt;Transit spoke virtual network.&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=26;fontFamily=Architects Daughter;fontColor=#000000;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="LdFzTjZZUpQZ4FR4s8Bu-2" vertex="1">
          <mxGeometry x="-6591" y="-1331" width="2457" height="2431" as="geometry" />
        </mxCell>
