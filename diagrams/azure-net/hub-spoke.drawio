        <mxCell id="thReB3ZlBnZ-oEYiUeje-640" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;BGP over IPSec (VNG Level, Connection level configuration, Enable on Local Network Gateway)&lt;/span&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: rgb(255, 255, 255);&quot;&gt;&lt;font color=&quot;#161616&quot; style=&quot;border-color: var(--border-color); font-size: 20px;&quot;&gt;&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;NVA Advertize 0/0 or split default into routes for BGP over IPSec Tunnel&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;ol style=&quot;border-color: var(--border-color); font-size: 20px;&quot;&gt;&lt;ol style=&quot;border-color: var(--border-color);&quot;&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Architects+Daughter&quot; style=&quot;border-color: var(--border-color); font-size: 20px;&quot;&gt;&lt;span style=&quot;border-color: var(--border-color);&quot;&gt;route 128.0.0.0/1 via 172.16.25.1;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Architects+Daughter&quot; style=&quot;border-color: var(--border-color); font-size: 20px;&quot;&gt;&lt;span style=&quot;border-color: var(--border-color);&quot;&gt;&amp;nbsp;route 0.0.0.0/1 via 172.16.25.1&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/ol&gt;&lt;div style=&quot;border-color: v