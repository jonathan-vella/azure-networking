        <mxCell id="BXbiH0vPpDBBbSI0rrvh-152" value="&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;When you create a&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;NodePort&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;service,&amp;nbsp;&lt;/span&gt;Kubernetes allocates a port from a default range (30000-32767).&amp;nbsp;This port will be open on every node in the cluster.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Any traffic that arrives&amp;nbsp;on a node at the&amp;nbsp;allocated port is forwarded to the &lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;service&#39;s&amp;nbsp;ClusterIP&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;When a network request is sent to the Service&#39;s ClusterIP, &lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;kube-proxy, which runs on every node, intercepts the request&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;.Kube-proxy uses the Service&#39;s selector to find all Pods that match it.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;These Pods can be on any node in the cluster.&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;Kube-proxy selects one of the matching Pods&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; (based on the Service&#39;s configured load balancing algorithm, such as round-robin or session affinity) and forwards the network request to that Pod&#39;s IP address.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The selected &lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;Pod processes the request and sends a response back&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;, which kube-proxy forwards back to the original requester.&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;" style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;html=1;" parent="BXbiH0vPpDBBbSI0rrvh-122" vertex="1">
          <mxGeometry x="-50" y="1310" width="2440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="BXbiH0vPpDBBbSI0rrvh-156" value="&lt;div&gt;&lt;font color=&quot;#330000&quot; face=&quot;Courier New&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font color=&quot;#330000&quot; face=&quot;Courier New&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Type: LoadBalancer&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#330000&quot; face=&quot;Courier New&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;10.101.4.219&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#330000&quot; face=&quot;Courier New&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;nginx service clsuter IP&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontFamily=Courier New;fontColor=#0000CC;" parent="BXbiH0vPpDBBbSI0rrvh-122" vertex="1">
