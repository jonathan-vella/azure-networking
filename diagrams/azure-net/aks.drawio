        <mxCell id="RmEEv3Yl5RT3NWJRKuHY-90" value="&lt;span style=&quot;font-size: 35px;&quot;&gt;Cluster Network&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=35;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;strokeWidth=3;fontColor=#FF9933;fontStyle=1" parent="WfwI8hsEHnIwHEpeUaaj-79" vertex="1">
