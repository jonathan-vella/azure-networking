        <mxCell id="RmEEv3Yl5RT3NWJRKuHY-96" value="This YAML file defines a Kubernetes Service of type&amp;nbsp;LoadBalancer&amp;nbsp;named&amp;nbsp;nginx-service-external&amp;nbsp;in the&amp;nbsp;demo-ns&amp;nbsp;namespace. It is designed to expose pods labeled with&amp;nbsp;app: nginx&amp;nbsp;externally. The service listens on port&amp;nbsp;8080&amp;nbsp;and forwards traffic to port&amp;nbsp;80&amp;nbsp;on the selected pods." style="text;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSize=21;" parent="RmEEv3Yl5RT3NWJRKuHY-92" vertex="1">
          <mxGeometry x="5070" y="-490" width="560" height="90" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div style=&quot;color: #d4d4d4;background-color: #1e1e1e;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;apiVersion&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;v1&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;kind&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;Service&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;metadata&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;name&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;nginx-service-internal&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;namespace&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;demo-ns&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;annotations&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;service.beta.kubernetes.io/azure-load-balancer-internal&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;true&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;spec&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;type&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;LoadBalancer&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;selector&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;app&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;nginx&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;ports&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &amp;nbsp; - &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;protocol&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;TCP&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;port&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;8080&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;targetPort&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;80&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" id="RmEEv3Yl5RT3NWJRKuHY-97">
          <mxCell style="text;whiteSpace=wrap;html=1;" parent="RmEEv3Yl5RT3NWJRKuHY-92" vertex="1">
            <mxGeometry x="5740" y="-520" width="560" height="310" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="RmEEv3Yl5RT3NWJRKuHY-98" value="This YAML defines a Kubernetes Service named&amp;nbsp;nginx-service-internal&amp;nbsp;within the&amp;nbsp;demo-ns&amp;nbsp;namespace. It&#39;s configured as an internal&amp;nbsp;LoadBalancer&amp;nbsp;type, specifically for Azure, as indicated by the annotation&amp;nbsp;service.beta.kubernetes.io/azure-load-balancer-internal: &quot;true&quot;. This Service is designed to route internal TCP traffic on port&amp;nbsp;8080&amp;nbsp;to pods labeled with&amp;nbsp;app: nginx, targeting port&amp;nbsp;80&amp;nbsp;on those pods." style="text;whiteSpace=wrap;html=1;fontSize=19;fontFamily=Architects Daughter;" parent="RmEEv3Yl5RT3NWJRKuHY-92" vertex="1">
          <mxGeometry x="6310" y="-500" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="RmEEv3Yl5RT3NWJRKuHY-99" value="&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;k describe service nginx-service-external -n demo-ns&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Name:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;nginx-service-external&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Namespace:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; demo-ns&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Labels:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;lt;none&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Annotations:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;lt;none&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Selector:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;app=nginx&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Type:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;LoadBalancer&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;IP Family Policy:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;SingleStack&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;IP Families:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IPv4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;IP:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;10.101.181.28&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;IPs:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 10.101.181.28&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;LoadBalancer Ingress:&amp;nbsp; &amp;nbsp; &amp;nbsp;52.226.157.228&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Port:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;lt;unset&amp;gt;&amp;nbsp; 8080/TCP&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;TargetPort:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;80/TCP&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;NodePort:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;lt;unset&amp;gt;&amp;nbsp; 30984/TCP&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Endpoints:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 172.16.240.31:80,172.16.240.4:80,172.16.240.79:80&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Session Affinity:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;None&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;External Traffic Policy:&amp;nbsp; Cluster&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;Events:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;&amp;nbsp; Type&amp;nbsp; &amp;nbsp; Reason&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Age&amp;nbsp; &amp;nbsp; From&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Message&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;&amp;nbsp; ----&amp;nbsp; &amp;nbsp; ------&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ----&amp;nbsp; &amp;nbsp;----&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -------&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px; font-weight: normal;&quot;&gt;&amp;nbsp; Normal&amp;nbsp; EnsuringLoadBalancer&amp;nbsp; 8m37s&amp;nbsp; service-controller&amp;nbsp; Ensuring load balancer&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;br style=&quot;font-size: 33px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;fontSize=33;fontFamily=Courier New;html=1;fontStyle=1" parent="RmEEv3Yl5RT3NWJRKuHY-92" vertex="1">
          <mxGeometry x="4630" width="1500" height="790" as="geometry" />
        </mxCell>
        <mxCell id="RmEEv3Yl5RT3NWJRKuHY-100" value="&lt;div&gt;Cluster IP: 10.101.181.28 (internal IP within the cluster)&lt;/div&gt;&lt;div&gt;LoadBalancer Ingress: 52.226.157.228 (external IP assigned by the cloud provider&#39;s load balancer)&lt;/div&gt;&lt;div&gt;Ports:&lt;/div&gt;&lt;div&gt;Port: 8080/TCP (external port)&lt;/div&gt;&lt;div&gt;TargetPort: 80/TCP (port on the selected pods)&lt;/div&gt;&lt;div&gt;NodePort: 30984/TCP (port on each node that routes to the Service)&lt;/div&gt;&lt;div&gt;Endpoints: IPs and ports of the selected pods (172.16.240.31:80, 172.16.240.4:80, 172.16.240.79:80)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In Azure Kubernetes Service (AKS) with Azure CNI, the LoadBalancer type Service can directly route traffic to the pods without needing a NodePort. However, the NodePort is still created as part of the Service configuration for several reasons:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Fallback Mechanism: If the load balancer fails or is misconfigured, the NodePort provides an alternative way to access the Service. You can access the Service using &amp;lt;NodeIP&amp;gt;:&amp;lt;NodePort&amp;gt;.&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;textShadow=0;fontSize=36;fontFamily=Courier New;" parent="RmEEv3Yl5RT3NWJRKuHY-92" vertex="1">
          <mxGeometry x="6360" y="-70" width="1210" height="850" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;[nehali@nehali-laptop demo-ns]$ k describe service nginx-service-internal -n demo-ns&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;Name:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;nginx-service-internal&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;Namespace:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; demo-ns&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;Labels:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;lt;none&amp;gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;Annotations:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; service.beta.kubernetes.io/azure-load-balancer-internal: true&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;Selector:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;app=nginx&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;&lt;span style=&quot;font-size: 33px;&quot;&gt;Type:&amp;nbsp; &amp;nbsp; 