        <mxCell id="iuW01DUFwlqtUmeC9Gpc-3" value="&lt;font color=&quot;#ff8000&quot; style=&quot;font-size: 35px;&quot;&gt;&lt;b style=&quot;font-size: 35px;&quot;&gt;10.101.0.0/16&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=35;fontFamily=Courier New;fontColor=#000000;strokeWidth=3;" parent="WfwI8hsEHnIwHEpeUaaj-79" vertex="1">
