        <mxCell id="ulzWm7laKPbTyR0MhrWg-40" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 91px;&quot;&gt;Notes&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;ol style=&quot;font-size: 75px;&quot;&gt;&lt;li style=&quot;font-size: 75px;&quot;&gt;Route table on the Subnet for East west, destination sees the original IPs&lt;/li&gt;&lt;li style=&quot;font-size: 75px;&quot;&gt;Oubound to Internet Fails: SNAT breaks IPVLAN&lt;/li&gt;&lt;li style=&quot;font-size: 75px;&quot;&gt;Solution for outbound: 0/0 via NVA (NVA does the SNAT, NVA sees Private IP of the container, NVA subnet route table for return traffic)&amp;nbsp;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=75;fontFamily=Courier New;fontStyle=1" parent="-YAH0WxDvjtc2-BXKION-86" vertex="1">
