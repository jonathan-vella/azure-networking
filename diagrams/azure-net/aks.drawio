        <mxCell id="Zud18U7og612hgk7SHhp-1" value="&lt;div style=&quot;font-size: 30px;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;div style=&quot;&quot;&gt;az aks create -l eastus -g $RG -n $AKSCLUSTER &lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;--network-plugin none&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;[nehali@nehali-1019 aks-azcli]$ k get nodes -o wide&lt;br style=&quot;&quot;&gt;NAME&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; STATUS&amp;nbsp; &amp;nbsp; &amp;nbsp;ROLES&amp;nbsp; &amp;nbsp;AGE&amp;nbsp; &amp;nbsp; &amp;nbsp;VERSION&amp;nbsp; &amp;nbsp;INTERNAL-IP&amp;nbsp; &amp;nbsp;EXTERNAL-IP&amp;nbsp; &amp;nbsp;OS-IMAGE&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;KERNEL-VERSION&amp;nbsp; &amp;nbsp; &amp;nbsp; CONTAINER-RUNTIME&lt;br style=&quot;&quot;&gt;aks-nodepool1-80705177-vmss000000&amp;nbsp; &amp;nbsp;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;NotReady&amp;nbsp;&lt;/span&gt; &amp;nbsp;agent&amp;nbsp; &amp;nbsp;6m11s&amp;nbsp; &amp;nbsp;v1.28.5&amp;nbsp; &amp;nbsp;10.224.0.6&amp;nbsp; &amp;nbsp; &amp;lt;none&amp;gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Ubuntu 22.04.4 LTS&amp;nbsp; &amp;nbsp;5.15.0-1060-azure&amp;nbsp; &amp;nbsp;containerd://1.7.15-1&lt;br style=&quot;&quot;&gt;aks-nodepool1-80705177-vmss000001&amp;nbsp; &amp;nbsp;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;NotReady&amp;nbsp;&lt;/span&gt; &amp;nbsp;agent&amp;nbsp; &amp;nbsp;6m9s&amp;nbsp; &amp;nbsp; v1.28.5&amp;nbsp; &amp;nbsp;10.224.0.4&amp;nbsp; &amp;nbsp; &amp;lt;none&amp;gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Ubuntu 22.04.4 LTS&amp;nbsp; &amp;nbsp;5.15.0-1060-azure&amp;nbsp; &amp;nbsp;containerd://1.7.15-1&lt;br style=&quot;&quot;&gt;aks-nodepool1-80705177-vmss000002&amp;nbsp; &amp;nbsp;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;NotReady&amp;nbsp;&lt;/span&gt; &amp;nbsp;agent&amp;nbsp; &amp;nbsp;6m9s&amp;nbsp; &amp;nbsp; v1.28.5&amp;nbsp; &amp;nbsp;10.224.0.5&amp;nbsp; &amp;nbsp; &amp;lt;none&amp;gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Ubuntu 22.04.4 LTS&amp;nbsp; &amp;nbsp;5.15.0-1060-azure&amp;nbsp; &amp;nbsp;containerd://1.7.15-1&lt;br style=&quot;&quot;&gt;[nehali@nehali-1019 aks-azcli]$&lt;/font&gt;" style="text;whiteSpace=wrap;fontFamily=Courier New;html=1;fontSize=25;" parent="AcSUpaBrBinRsQVvcUlR-7" vertex="1">
