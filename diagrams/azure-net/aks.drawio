        <mxCell id="QuYo4Uh_7gCeBywGViag-56" value="" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=35;image=img/lib/azure2/networking/Load_Balancers.svg;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="RmEEv3Yl5RT3NWJRKuHY-86" vertex="1">
