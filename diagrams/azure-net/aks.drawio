        </UserObject>
        <mxCell id="YLipig3j6BaiT96UUwU8-49" value="This YAML defines a Kubernetes Service named&amp;nbsp;nginx-service-internal&amp;nbsp;within the&amp;nbsp;demo-ns&amp;nbsp;namespace. It&#39;s configured as an internal&amp;nbsp;LoadBalancer&amp;nbsp;type, specifically for Azure, as indicated by the annotation&amp;nbsp;service.beta.kubernetes.io/azure-load-balancer-internal: &quot;true&quot;. This Service is designed to route internal TCP traffic on port&amp;nbsp;8080&amp;nbsp;to pods labeled with&amp;nbsp;app: nginx, targeting port&amp;nbsp;80&amp;nbsp;on those pods." style="text;whiteSpace=wrap;html=1;fontSize=19;fontFamily=Architects Daughter;" parent="AcSUpaBrBinRsQVvcUlR-27" vertex="1">
          <mxGeometry x="4090" y="-190" width="560" height="90" as="geometry" />
