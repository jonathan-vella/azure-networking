        <mxCell id="AmPbSOTsEj-LQQa_ocP6-16" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Courier New&amp;quot;; font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;Outbound: 4.255.67.123&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;labelBackgroundColor=#FF9933;" parent="WfwI8hsEHnIwHEpeUaaj-80" vertex="1">
