        <mxCell id="RmEEv3Yl5RT3NWJRKuHY-48" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Courier New&amp;quot;; font-size: 36px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;ELB: Inbound: 135.237.110.180:8080&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;labelBackgroundColor=#33FF33;" parent="RmEEv3Yl5RT3NWJRKuHY-86" vertex="1">
