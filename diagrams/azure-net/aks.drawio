        <mxCell id="gjx5_syKnFXWjm4SH8Xj-47" value="&lt;div&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size: 28px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size: 28px;&quot;&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size: 28px; background-color: rgb(153, 255, 153);&quot;&gt;Cluster INFO:&lt;/font&gt;&lt;/div&gt;k get nodes,pods,services -o wide -n demo-ns&lt;br&gt;NAME&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;STATUS&amp;nbsp; &amp;nbsp;ROLES&amp;nbsp; &amp;nbsp; AGE&amp;nbsp; &amp;nbsp; &amp;nbsp;VERSION&amp;nbsp; &amp;nbsp;INTERNAL-IP&amp;nbsp; &amp;nbsp; &amp;nbsp;EXTERNAL-IP&amp;nbsp; &amp;nbsp;OS-IMAGE&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;KERNEL-VERSION&amp;nbsp; &amp;nbsp; &amp;nbsp; CONTAINER-RUNTIME&lt;br&gt;node/aks-nodepool1-39912156-vmss000000&amp;nbsp; &amp;nbsp;Ready&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;3h25m&amp;nbsp; &amp;nbsp;v1.29.6&amp;nbsp; &amp;nbsp;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;172.16.240.39&lt;/span&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Ubuntu 22.04.4 LTS&amp;nbsp; &amp;nbsp;5.15.0-1067-azure&amp;nbsp; &amp;nbsp;containerd://1.7.15-1&lt;br&gt;node/aks-nodepool1-39912156-vmss000001&amp;nbsp; &amp;nbsp;Ready&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;3h25m&amp;nbsp; &amp;nbsp;v1.29.6&amp;nbsp; &amp;nbsp;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;172.16.240.65&lt;/span&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Ubuntu 22.04.4 LTS&amp;nbsp; &amp;nbsp;5.15.0-1067-azure&amp;nbsp; &amp;nbsp;containerd://1.7.15-1&lt;br&gt;node/aks-nodepool1-39912156-vmss000002&amp;nbsp; &amp;nbsp;Ready&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;3h25m&am