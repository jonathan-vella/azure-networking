        <mxCell id="laxz53Nn7ZFMzm-YWPTC-855" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;HQ Site&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontSize=40;fontFamily=Architects Daughter;fontColor=#009900;fontStyle=1;labelBackgroundColor=none;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="laxz53Nn7ZFMzm-YWPTC-808" vertex="1">
