        <mxCell id="HSeb9QydXlyR8dXeI55r-2" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0); font-size: 25px;&quot;&gt;&lt;b style=&quot;&quot;&gt;root@bird-nva-east&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;:/home/nehali# ip add&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;1: lo:  mtu 65536 qdisc noqueue state UNKNOWN group default qlen 1000&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; link/loopback 00:00:00:00:00:00 brd 00:00:00:00:00:00&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; inet 127.0.0.1/8 scope host lo&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;valid_lft forever preferred_lft forever&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; inet6 ::1/128 scope host&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;valid_lft forever preferred_lft forever&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;2:&lt;span style=&quot;background-color: rgb(255, 255, 0);&quot;&gt; eth0:&lt;/span&gt;  mtu 1500 qdisc mq state UP group default qlen 1000&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; link/ether 00:0d:3a:57:a4:e6 brd ff:ff:ff:ff:ff:ff&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 25px;&quot; color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; inet &lt;span style=&quot;background-color: rgb(255, 255, 0);&quot;&gt;172.16.25.4&lt;/span&gt;/24 brd 172.16.25.255 scope global eth0&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;valid_lft forever preferred_lft forever&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&a