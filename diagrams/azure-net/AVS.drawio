        <mxCell id="VCiR_Nc5026qMbj0VXpn-6" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: nowrap;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;Step 1:&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: nowrap;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;Add a new segment&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=68;fontStyle=1;labelBackgroundColor=none;fontColor=#FF8000;" vertex="1" parent="VCiR_Nc5026qMbj0VXpn-0">
