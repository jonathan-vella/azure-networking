        <mxCell id="laxz53Nn7ZFMzm-YWPTC-872" value="&lt;div class=&quot;&quot; data-block=&quot;true&quot; data-editor=&quot;bcr6h&quot; data-offset-key=&quot;4f22p-0-0&quot; style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;&lt;b style=&quot;font-size: 40px;&quot;&gt;Transit VNET Design Notes:&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;&lt;br style=&quot;font-size: 40px;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 51);&quot;&gt;Use case:&lt;/span&gt;&amp;nbsp;Legacy Approach to workaround the 400 Route limitation, If you already have hub-spoke architecture, Not compatible with Global Reach&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;NVA HA and LB Design (Preserve symetry)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;Right NVA - is Router NVA&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;Left NVA - Firewall NVA&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;&lt;br style=&quot;font-size: 40px;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div data-offset-key=&quot;4f22p-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;font-weight: 400; position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;4f22p-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;BGP NVA: &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; data-block=&quot;true&quot; data-editor=&quot;bcr6h&quot; data-offset-key=&quot;9qgti-0-0&quot; style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div data-offset-key=&quot;9qgti-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;9qgti-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;1. Peers with both ARS&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; data-block=&quot;true&quot; data-editor=&quot;bcr6h&quot; data-offset-key=&quot;dj8aa-0-0&quot; style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div data-offset-key=&quot;dj8aa-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;dj8aa-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;2. OS level it learns on-prem routes, all specific AVS routes.   UDR need NIC to route traffic to on-prem. On-prem via firewall NVA, 0/0 via f/w NVA&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; data-block=&quot;true&quot; data-editor=&quot;bcr6h&quot; data-offset-key=&quot;10h2s-0-0&quot; style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div data-offset-key=&quot;10h2s-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;10h2s-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;3.  BGP NVA advertizes /22 (summary route) to ARS on left. Left ARS programs that into the VNET and gateway subnet with the next hop of BGP NVA. To overwrite that we need a /22 summary route in the gateway subnet - Must summarize&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; data-block=&quot;true&quot; data-editor=&quot;bcr6h&quot; data-offset-key=&quot;6cjn5-0-0&quot; style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div data-offset-key=&quot;6cjn5-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-offset-key=&quot;6cjn5-0-0&quot;&gt;&lt;br style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; data-block=&quot;true&quot; data-editor=&quot;bcr6h&quot; data-offset-key=&quot;bru5l-0-0&quot; style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div data-offset-key=&quot;bru5l-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span data-offset-key=&quot;bru5l-0-0&quot; style=&quot;font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;4. Expert COmments: Single NIC/Dual NIC design&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; data-block=&quot;true&quot; data-editor=&quot;bcr6h&quot; data-offset-key=&quot;bmui4-0-0&quot; style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div data-offset-key=&quot;bmui4-0-0&quot; class=&quot;public-DraftStyleDefault-block public-DraftStyleDefault-ltr&quot; style=&quot;position: relative; direction: ltr; text-align: left; font-size: 40px;&quot;&gt;&lt;span style=&quot;font-size: 40px;&quot; data-offset-key=&quot;bmui4-0-0&quot;&gt;&lt;br style=&quot;font-size: 40px;&quot; data-text=&quot;true&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; data-block=&quot;true&quot; data-editor=&quot;bcr6h&quot; data-offset-key=&quot;f9ol7-0-0&quot; style=&quot;color: rgb(0, 0, 0); font-size: 40px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; 